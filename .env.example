# OneClick AI Backend - Environment Variables
# Copy this file to .env and fill in your values
# For Railway deployment, set these in Railway dashboard or CLI

# LLM Provider Configuration (REQUIRED)
LLM_API_KEY=your_openai_or_anthropic_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Server Configuration (OPTIONAL - Railway sets these automatically)
# HOST=0.0.0.0                 # Railway provides this
# PORT=8000                    # Railway provides this dynamically

# Logging (OPTIONAL)
RUST_LOG=info

# Request Configuration (OPTIONAL)
REQUEST_TIMEOUT=1800
MAX_RETRIES=2

# Database (for future production use)
# DATABASE_URL=postgres://user:password@host:5432/database

# Stripe (for payments - future)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (for web dashboard - future)
# JWT_SECRET=your-secret-key-min-32-chars
